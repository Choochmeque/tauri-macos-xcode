set -e
# CI experiment: trace the phase (stderr onto stdout so xcodebuild keeps it)
exec 2>&1
set -x
echo "whoami=$(whoami) HOME=$HOME PATH=$PATH"
echo "swift=$(command -v swift || echo MISSING)"; swift --version || true
echo "cargo=$(command -v cargo || echo MISSING)"; ls -la "$HOME/.cargo/env" || true

# Source cargo environment (needed when running from Xcode)
source "$HOME/.cargo/env" 2>/dev/null || true

# Environment setup for Swift script
export CARGO_TARGET_DIR="${BUILD_DIR}/cargo-target"
