#!/bin/bash
# Generated by tauri-macos-xcode - https://github.com/Choochmeque/tauri-macos-xcode
set -e

# Put a rustup-installed cargo on PATH (needed when running from Xcode). The file does not exist
# when rustup came from Homebrew; sourcing a missing file under set -e aborts the script.
if [ -f "$HOME/.cargo/env" ]; then
  # shellcheck disable=SC1091
  . "$HOME/.cargo/env"
fi

# Environment setup for Swift script
export CARGO_TARGET_DIR="${BUILD_DIR}/cargo-target"
export PROJECT_ROOT="${PROJECT_DIR}/../.."

# Run Swift build script
exec swift "$(dirname "$0")/build.swift" "$1" "$2"
